# NahaKids / PayFast
# Keep all PayFast secrets server-side. Never expose these in NEXT_PUBLIC_* variables.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Public HTTPS origin used by PayFast return/ITN callbacks.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Durable payment orders / entitlements.
# Neon Postgres connection string used by Drizzle.
DATABASE_URL=

# Sprite worker. The shared secret is mandatory; web and worker both fail closed without it.
SPRITE_GEN_WORKER_URL=
SPRITE_GEN_SHARED_SECRET=

# Server-side operator deletion credential. Never expose as NEXT_PUBLIC_*.
GAME_ADMIN_DELETE_SECRET=
