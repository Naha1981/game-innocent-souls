# NahaKids / Payfast
# Keep all Payfast secrets server-side. Never expose these in NEXT_PUBLIC_* variables.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Public HTTPS origin used by Payfast return/ITN callbacks.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Existing sprite generation configuration remains in the deployment environment.
# SPRITE_GEN_WORKER_URL=
# SPRITE_GEN_WORKER_SECRET=
