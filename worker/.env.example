# Absolute path to the dedicated sprite-gen 2.1.0 installation.
SPRITE_GEN_ROOT=/opt/sprite-gen

# Optional shared secret between the Next.js server and this worker.
# Set this in production; never expose it to the browser.
SPRITE_GEN_SHARED_SECRET=replace-me

# Temporary source-image directory. Keep it on ephemeral local storage.
SPRITE_GEN_SOURCE_ROOT=/tmp/nahakids-source
SPRITE_GEN_WORK_ROOT=/tmp/nahakids-runs

# Hard ceiling per pipeline stage. Generation can be slow because provider calls are remote.
SPRITE_GEN_TIMEOUT_SECONDS=900

# Default provider; every job still declares its provider explicitly.
SPRITE_GEN_PROVIDER=codex
